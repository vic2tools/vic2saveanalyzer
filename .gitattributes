# Keep LF in the repo and in the working copy, which is how these files are
# written. Without this, core.autocrlf rewrites every file on checkout and the
# first diff after a clone is the whole tree.
* text=auto eol=lf

# The licence is a verbatim document; never let it be rewritten.
LICENSE -text

# The built executable is bytes. `text=auto` above would normally leave it
# alone on its own, but a 13 MB artifact is not worth leaving to a heuristic.
*.exe -text
