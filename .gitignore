# Generated report output. `vic2_report/` is the tool's default -o folder, so it
# reappears on every run; everything in it is derived from saves.
vic2_report/
legacybackup/vic2_report/
*.csv
!legacybackup/mob_readings.txt

# Reports are regenerated from the CSVs; the one kept example is forced back in.
report.html
!legacybackup/example_report.html

# Python bytecode
__pycache__/
*.py[cod]

# Victoria 2 saves are 20-30 MB each and belong to the game, not the tool
*.v2

# Editor and OS noise
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# Everything the build leaves behind. `python build_exe.py` regenerates all of
# it, including the icon, so none of it is worth tracking -- except the finished
# executable, which is tracked deliberately: it is what someone who does not
# have Python installed actually downloads. Note `dist/*` rather than `dist/`:
# git will not re-include a file underneath an excluded directory, so the
# directory has to stay listed for the negation below to be read at all.
build/
dist/*
!dist/vic2saveanalyzer.exe
dist_new/
vic2.ico

# Working notes and superseded files from before the first release. They stay
# on disk and in git history; they are not part of what ships.
legacybackup/

# Settings the program writes. On Windows these live under APPDATA; on a
# machine without it the old fallback put them here, inside the checkout.
settings.json
keeper.json

# The Rust scanner is built with cargo; its target directory is build
# output, and the binary itself is carried into the executable rather than
# tracked here.
scanner/target/

# Except the tables the checks are held to (testkit/expected.py).
!testkit/expected/**/*.csv

# The speed job's settings for this machine: its campaign, its mod and what
# must stay private (speed/prepush.sh).
speed/local.env
