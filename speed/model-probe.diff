index 0000000..166fb75
--- /dev/null
+++ b/scanner/src/probe.rs
@@ -0,0 +1,203 @@
+// PROBE ONLY (task 05): never committed. A counting allocator, a census of
+// what a nation holds, and switches that reverse one field's order.
+
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::cell::Cell;
+use std::collections::BTreeMap;
+use std::sync::atomic::{AtomicI64, AtomicU64, Ordering::Relaxed};
+use std::sync::Mutex;
+
+// ------------------------------------------------------------- allocator
+
+pub struct Counting;
+
+pub static ENABLED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+pub static LIVE_N: AtomicI64 = AtomicI64::new(0);
+pub static LIVE_B: AtomicI64 = AtomicI64::new(0);
+pub static PEAK_B: AtomicI64 = AtomicI64::new(0);
+pub static TOTAL_N: AtomicU64 = AtomicU64::new(0);
+
+thread_local! {
+    static T_ALLOCS: Cell<u64> = const { Cell::new(0) };
+    static T_REALLOCS: Cell<u64> = const { Cell::new(0) };
+    static T_FREES: Cell<u64> = const { Cell::new(0) };
+    static T_BYTES: Cell<u64> = const { Cell::new(0) };
+}
+
+fn up(size: usize) {
+    if !ENABLED.load(Relaxed) {
+        return;
+    }
+    LIVE_N.fetch_add(1, Relaxed);
+    TOTAL_N.fetch_add(1, Relaxed);
+    let b = LIVE_B.fetch_add(size as i64, Relaxed) + size as i64;
+    if b > PEAK_B.load(Relaxed) {
+        PEAK_B.store(b, Relaxed);
+    }
+    let _ = T_ALLOCS.try_with(|c| c.set(c.get() + 1));
+    let _ = T_BYTES.try_with(|c| c.set(c.get() + size as u64));
+}
+
+unsafe impl GlobalAlloc for Counting {
+    unsafe fn alloc(&self, l: Layout) -> *mut u8 {
+        up(l.size());
+        System.alloc(l)
+    }
+    unsafe fn alloc_zeroed(&self, l: Layout) -> *mut u8 {
+        up(l.size());
+        System.alloc_zeroed(l)
+    }
+    unsafe fn dealloc(&self, p: *mut u8, l: Layout) {
+        if ENABLED.load(Relaxed) {
+            LIVE_N.fetch_sub(1, Relaxed);
+            LIVE_B.fetch_sub(l.size() as i64, Relaxed);
+            let _ = T_FREES.try_with(|c| c.set(c.get() + 1));
+        }
+        System.dealloc(p, l)
+    }
+    unsafe fn realloc(&self, p: *mut u8, l: Layout, new: usize) -> *mut u8 {
+        if ENABLED.load(Relaxed) {
+            LIVE_B.fetch_add(new as i64 - l.size() as i64, Relaxed);
+            let _ = T_REALLOCS.try_with(|c| c.set(c.get() + 1));
+            let _ = T_BYTES.try_with(|c| c.set(c.get() + new as u64));
+        }
+        System.realloc(p, l, new)
+    }
+}
+
+/// This thread's (allocs, reallocs, frees, bytes) so far, and the clock in ns.
+pub fn snap() -> [u64; 5] {
+    use std::sync::OnceLock;
+    static T0: OnceLock<std::time::Instant> = OnceLock::new();
+    let ns = T0.get_or_init(std::time::Instant::now).elapsed().as_nanos() as u64;
+    [T_ALLOCS.with(|c| c.get()), T_REALLOCS.with(|c| c.get()), T_FREES.with(|c| c.get()),
+     T_BYTES.with(|c| c.get()), ns]
+}
+
+/// Counting costs an atomic or two a call: only when a probe output was asked for.
+pub fn init() {
+    if std::env::var_os("VIC2_ALLOC").is_some() || std::env::var_os("VIC2_STAGES").is_some()
+        || std::env::var_os("VIC2_STATS").is_some() {
+        ENABLED.store(true, Relaxed);
+    }
+}
+
+pub fn global_line() -> String {
+    format!("live {} allocs {:.1} MB (peak {:.1} MB); {} allocs so far", LIVE_N.load(Relaxed),
+            LIVE_B.load(Relaxed) as f64 / 1e6, PEAK_B.load(Relaxed) as f64 / 1e6, TOTAL_N.load(Relaxed))
+}
+
+static STAGES: Mutex<BTreeMap<&'static str, [u64; 6]>> = Mutex::new(BTreeMap::new());
+
+/// Run `f` and add what this thread allocated in it to `name`:
+/// [calls, allocs, reallocs, frees, bytes].
+pub fn staged<T>(name: &'static str, f: impl FnOnce() -> T) -> T {
+    let a = snap();
+    let t = f();
+    let b = snap();
+    let mut s = STAGES.lock().unwrap();
+    let e = s.entry(name).or_insert([0; 6]);
+    e[0] += 1;
+    for i in 0..4 {
+        e[i + 1] += b[i].wrapping_sub(a[i]);
+    }
+    e[5] += b[4] - a[4];
+    t
+}
+
+/// What a clone of a value allocates is what the value holds.
+pub fn held<T>(name: &'static str, v: &T, clone: impl Fn(&T) -> Box<dyn std::any::Any>) {
+    let a = snap();
+    let c = clone(v);
+    let b = snap();
+    drop(c);
+    let mut s = HELD.lock().unwrap();
+    let e = s.entry(name).or_insert([0; 3]);
+    e[0] += 1;
+    e[1] += b[0] - a[0];
+    e[2] += b[3] - a[3];
+}
+static HELD: Mutex<BTreeMap<&'static str, [u64; 3]>> = Mutex::new(BTreeMap::new());
+
+// ---------------------------------------------------------------- census
+
+#[derive(Default)]
+struct Census {
+    lens: BTreeMap<String, Vec<u32>>,
+    words: BTreeMap<&'static str, BTreeMap<String, u64>>,
+}
+static CENSUS: Mutex<Option<Census>> = Mutex::new(None);
+
+pub fn note(field: &str, n: usize, kept: bool) {
+    let mut g = CENSUS.lock().unwrap();
+    let c = g.get_or_insert_with(Census::default);
+    c.lens.entry(format!("all  {}", field)).or_default().push(n as u32);
+    if kept {
+        c.lens.entry(format!("kept {}", field)).or_default().push(n as u32);
+    }
+}
+
+pub fn word(class: &'static str, s: &str) {
+    let mut g = CENSUS.lock().unwrap();
+    let c = g.get_or_insert_with(Census::default);
+    *c.words.entry(class).or_default().entry(s.to_string()).or_insert(0) += 1;
+}
+
+pub fn dump_to(path: &str) {
+    let mut out = String::new();
+    {
+        let s = STAGES.lock().unwrap();
+        out.push_str("== allocation by stage (this thread; per call: allocs reallocs frees bytes)\n");
+        for (k, v) in s.iter() {
+            out.push_str(&format!("{:<28} calls {:>6}  allocs {:>12}  reallocs {:>11}  frees {:>12}  bytes {:>14}  ms {:>9.1}  ms/call {:>7.2}\n",
+                                  k, v[0], v[1], v[2], v[3], v[4], v[5] as f64 / 1e6, v[5] as f64 / 1e6 / v[0].max(1) as f64));
+        }
+    }
+    {
+        let s = HELD.lock().unwrap();
+        out.push_str("\n== what is held (allocations a clone makes, summed over every save)\n");
+        for (k, v) in s.iter() {
+            out.push_str(&format!("{:<34} values {:>8}  allocs {:>11}  bytes {:>13}\n", k, v[0], v[1], v[2]));
+        }
+    }
+    let g = CENSUS.lock().unwrap();
+    if let Some(c) = g.as_ref() {
+        out.push_str("\n== entries per nation (or per save for meta.*): n  total  mean  median  p90  max  nonempty\n");
+        for (k, v) in &c.lens {
+            let mut v = v.clone();
+            v.sort();
+            let n = v.len();
+            let total: u64 = v.iter().map(|&x| x as u64).sum();
+            let nonempty = v.iter().filter(|&&x| x > 0).count();
+            out.push_str(&format!("{:<44} n {:>6}  total {:>9}  mean {:>8.2}  med {:>5}  p90 {:>5}  max {:>6}  nonempty {:>6}\n",
+                                  k, n, total, total as f64 / n.max(1) as f64, v[n / 2], v[n * 9 / 10], v[n - 1], nonempty));
+        }
+        out.push_str("\n== names by class: occurrences, distinct, mean length\n");
+        for (k, m) in &c.words {
+            let occ: u64 = m.values().sum();
+            let bytes: usize = m.keys().map(|s| s.len()).sum();
+            out.push_str(&format!("{:<24} occurrences {:>10}  distinct {:>6}  mean length {:>5.1}\n", k, occ,
+                                  m.len(), bytes as f64 / m.len().max(1) as f64));
+        }
+    }
+    let _ = std::fs::write(path, out);
+}
+
+// ----------------------------------------------------------- permutation
+
+pub fn on(name: &str) -> bool {
+    use std::sync::OnceLock;
+    static LIST: OnceLock<Vec<String>> = OnceLock::new();
+    LIST.get_or_init(|| std::env::var("VIC2_PERMUTE").unwrap_or_default().split(',')
+        .map(|s| s.to_string()).collect()).iter().any(|s| s == name)
+}
+
+pub fn add_stage(name: &'static str, a: [u64; 5], b: [u64; 5]) {
+    let mut s = STAGES.lock().unwrap();
+    let e = s.entry(name).or_insert([0; 6]);
+    e[0] += 1;
+    for i in 0..4 {
+        e[i + 1] += b[i].wrapping_sub(a[i]);
+    }
+    e[5] += b[4] - a[4];
+}
