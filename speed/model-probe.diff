+fn probe_census(meta: &Meta, keys: &[String], nations: &[Nation], spec: &Spec) {
+    use crate::probe::{note, word};
+    if std::env::var_os("VIC2_STATS").is_none() {
+        return;
+    }
+    let f = false;
+    note("meta.nations", nations.len(), f);
+    note("meta.province_owner", meta.province_owner.len(), f);
+    note("meta.great_nations", meta.great_nations.len(), f);
+    note("meta.wars", meta.wars.len(), f);
+    note("meta.battles", meta.wars.iter().map(|w| w.battles.len()).sum(), f);
+    note("meta.joins+leaves", meta.wars.iter().map(|w| w.joins.len() + w.leaves.len()).sum(), f);
+    note("meta.goals", meta.wars.iter().map(|w| w.goals.len()).sum(), f);
+    note("meta.war side tags", meta.wars.iter().map(|w| w.attackers.len() + w.defenders.len() + w.fighting.len()).sum(), f);
+    note("meta.battle units", meta.wars.iter().flat_map(|w| w.battles.iter())
+        .map(|b| b.attacker.iter().chain(b.defender.iter()).map(|s| s.units.len()).sum::<usize>()).sum(), f);
+    if let Some(m) = &meta.market {
+        note("meta.market.current", m.current.len(), f);
+        note("meta.market.history", m.history.len(), f);
+        for (i, s) in m.snapshot.iter().enumerate() {
+            note(&format!("meta.market.snapshot[{}]", i), s.len(), f);
+        }
+        for g in m.current.keys() { word("good", g); }
+        for (_, g, _) in &m.history { word("good", g); }
+    }
+    for (_, o, c) in &meta.province_owner { word("tag(owner/controller)", o); word("tag(owner/controller)", c); }
+    for w in &meta.wars {
+        word("war: name", &w.name); word("war: tag (original sides, side lists, fighting)", &w.original_attacker);
+        word("war: tag (original sides, side lists, fighting)", &w.original_defender);
+        for t in w.attackers.iter().chain(&w.defenders).chain(&w.fighting) { word("war: tag (original sides, side lists, fighting)", t); }
+        word("war: date", &w.start); word("war: date", &w.end);
+        for (d, t, _) in w.joins.iter().chain(&w.leaves) { word("war: date", d); word("war: tag (original sides, side lists, fighting)", t); }
+        for g in &w.goals { word("war: casus belli", &g.casus_belli); word("war: date", &g.added); }
+        for b in &w.battles {
+            word("war: battle name", &b.name);
+            if let Some(d) = &b.date { word("war: date", d); }
+            for sd in b.attacker.iter().chain(b.defender.iter()) {
+                word("war: leader", &sd.leader); word("war: tag (original sides, side lists, fighting)", &sd.country);
+                for (k, _) in sd.units.iter() { word("war: battle unit kind", k); }
+            }
+        }
+    }
+    if let Some(m) = &meta.market { for (st, _, _) in &m.history { word("market: stamp", st); } }
+    for (key, n) in keys.iter().zip(nations) {
+        let kept = spec.keeps(key, n);
+        let nn = |f: &str, v: usize| note(f, v, kept);
+        nn("nation.accepted_cultures", n.accepted_cultures.len());
+        nn("nation.ships_by_type", n.ships_by_type.len());
+        nn("nation.ship_crew", n.ship_crew.len());
+        nn("nation.regiments_by_type", n.regiments_by_type.len());
+        nn("nation.units_at (provinces)", n.units_at.len());
+        nn("nation.units_at (inner entries)", n.units_at.values().map(|m| m.len()).sum());
+        nn("nation.men_at (provinces)", n.men_at.len());
+        nn("nation.men_at (inner entries)", n.men_at.values().map(|m| m.len()).sum());
+        nn("nation.tech_list", n.tech_list.len());
+        nn("nation.invention_ids", n.invention_ids.len());
+        nn("nation.modifiers", n.modifiers.len());
+        nn("nation.country_flags", n.country_flags.len());
+        nn("nation.reforms", n.reforms.len());
+        nn("nation.pop_by_type", n.pop_by_type.len());
+        nn("nation.pop_by_culture", n.pop_by_culture.len());
+        nn("nation.goods_supply", n.goods_supply.len());
+        nn("nation.soldier_pops_at (provinces)", n.soldier_pops_at.len());
+        nn("nation.soldier_pops_at (sizes)", n.soldier_pops_at.iter().map(|(_, v)| v.len()).sum());
+        nn("nation.core_provinces", n.core_provinces.len());
+        nn("nation.colonial_level", n.colonial_level.len());
+        nn("nation.province_colonial", n.province_colonial.len());
+        nn("nation.colonial_provinces", n.colonial_provinces.len());
+        nn("nation.province_state", n.province_state.len());
+        nn("nation.occupied_provinces", n.occupied_provinces.len());
+        nn("nation.population_by_state (groups)", n.population_by_state.len());
+        nn("nation.population_by_state (type entries)", n.population_by_state.iter().map(|g| g.types.len()).sum());
+        nn("nation.population_by_state (culture entries)", n.population_by_state.iter().map(|g| g.cultures.len()).sum());
+        nn("nation.mobilizable_pops", n.mobilizable_pops.len());
+        for c in &n.accepted_cultures { word("culture", c); }
+        word("culture", &n.primary_culture);
+        for (k, _) in n.pop_by_culture.iter() { word("culture", k); }
+        for g in &n.population_by_state {
+            for (c, _) in &g.cultures { word("culture", c); }
+            for (t, _) in &g.types { word("poptype", t); }
+        }
+        for (t, _) in n.pop_by_type.iter() { word("poptype", t); }
+        for (k, c, _, _) in &n.mobilizable_pops { word("poptype", k); word("culture", c); }
+        for (t, _) in n.ships_by_type.iter() { word("shiptype", t); }
+        for (t, _) in n.ship_crew.iter() { word("shiptype", t); }
+        for (t, _) in n.regiments_by_type.iter() { word("regtype", t); }
+        for m in n.units_at.values().chain(n.men_at.values()) {
+            for (t, _) in m.iter() { word("unit kind (units_at/men_at)", t); }
+        }
+        for t in &n.tech_list { word("tech", t); }
+        for t in &n.modifiers { word("modifier", t); }
+        for t in n.country_flags.iter() { word("flag", t); }
+        for (k, v) in n.reforms.iter() { word("reform key", k); word("reform value", v); }
+        for (g, _) in n.goods_supply.iter() { word("good", g); }
+        word("tag", key); word("tag", &n.tag);
+        word("government", &n.government);
+        word("nationalvalue", &n.nationalvalue);
+        word("civilized", &n.civilized);
+        word("capital", &n.capital);
+    }
+}
+
+fn rev<T>(v: &mut Vec<T>) {
+    v.reverse();
+}
+
+fn probe_permute(meta: &mut Meta, nations: &mut Vec<Nation>, keys: &mut Vec<String>) {
+    use crate::probe::on;
+    if on("nations") { rev(nations); rev(keys); }
+    if on("province_owner") { rev(&mut meta.province_owner); }
+    if on("great_nations") { rev(&mut meta.great_nations); }
+    if on("wars") { rev(&mut meta.wars); }
+    for w in meta.wars.iter_mut() {
+        if on("war.battles") { rev(&mut w.battles); }
+        if on("war.joins") { rev(&mut w.joins); rev(&mut w.leaves); }
+        if on("war.goals") { rev(&mut w.goals); }
+        if on("war.units") {
+            for b in w.battles.iter_mut() {
+                if let Some(s) = b.attacker.as_mut() { s.units.reverse(); }
+                if let Some(s) = b.defender.as_mut() { s.units.reverse(); }
+            }
+        }
+    }
+    if let Some(m) = meta.market.as_mut() {
+        if on("market.current") { m.current.reverse(); }
+        if on("market.history") { rev(&mut m.history); }
+        if on("market.snapshot") { for s in m.snapshot.iter_mut() { s.reverse(); } }
+    }
+    for n in nations.iter_mut() {
+        if on("accepted_cultures") { rev(&mut n.accepted_cultures); }
+        if on("ships_by_type") { n.ships_by_type.reverse(); }
+        if on("ship_crew") { n.ship_crew.reverse(); }
+        if on("regiments_by_type") { n.regiments_by_type.reverse(); }
+        if on("units_at") { n.units_at.reverse(); }
+        if on("units_at.inner") { for m in n.units_at.values_mut() { m.reverse(); } }
+        if on("men_at") { n.men_at.reverse(); }
+        if on("men_at.inner") { for m in n.men_at.values_mut() { m.reverse(); } }
+        if on("tech_list") { rev(&mut n.tech_list); }
+        if on("invention_ids") { rev(&mut n.invention_ids); }
+        if on("modifiers") { rev(&mut n.modifiers); }
+        if on("reforms") { n.reforms.reverse(); }
+        if on("pop_by_type") { n.pop_by_type.reverse(); }
+        if on("pop_by_culture") { n.pop_by_culture.reverse(); }
+        if on("goods_supply") { n.goods_supply.reverse(); }
+        if on("mobilizable_pops") { rev(&mut n.mobilizable_pops); }
+        if on("soldier_pops_at") { rev(&mut n.soldier_pops_at); }
+        if on("soldier_pops_at.inner") { for (_, v) in n.soldier_pops_at.iter_mut() { rev(v); } }
+        if on("population_by_state") { rev(&mut n.population_by_state); }
+        if on("group.types") { for g in n.population_by_state.iter_mut() { rev(&mut g.types); } }
+        if on("group.cultures") { for g in n.population_by_state.iter_mut() { rev(&mut g.cultures); } }
+    }
+}
+
+fn probe_held(meta: &Meta, out: &[PreNation], held: &[Held], chunk: &String) {
+    use crate::probe::held as h;
+    if std::env::var_os("VIC2_STATS").is_none() {
+        return;
+    }
+    h("Pre.chunk (String)", chunk, |v| Box::new(v.clone()));
+    h("Pre.meta (whole)", meta, |v| Box::new(v.clone()));
+    h("Meta.province_owner", &meta.province_owner, |v| Box::new(v.clone()));
+    h("Meta.wars", &meta.wars, |v| Box::new(v.clone()));
+    h("Meta.market", &meta.market, |v| Box::new(v.clone()));
+    if let Some(m) = &meta.market {
+        h("Market.current", &m.current, |v| Box::new(v.clone()));
+        h("Market.history", &m.history, |v| Box::new(v.clone()));
+        h("Market.snapshot[7]", &m.snapshot, |v| Box::new(v.clone()));
+    }
+    for n in out {
+        let nat = &n.nat;
+        h("PreNation (whole nat)", nat, |v| Box::new(v.clone()));
+        h("PreNation.tag (String)", &n.tag, |v| Box::new(v.clone()));
+        h("PreNation.buckets (Vec<i64>)", &n.buckets, |v| Box::new(v.clone()));
+        h("nat: key,tag,primary_culture,civilized,government,capital,nationalvalue", &(nat.key.clone(), nat.tag.clone(),
+          nat.primary_culture.clone(), nat.civilized.clone(), nat.government.clone(),
+          nat.capital.clone(), nat.nationalvalue.clone()), |v| Box::new(v.clone()));
+        h("nat.accepted_cultures", &nat.accepted_cultures, |v| Box::new(v.clone()));
+        h("nat.ships_by_type", &nat.ships_by_type, |v| Box::new(v.clone()));
+        h("nat.ship_crew", &nat.ship_crew, |v| Box::new(v.clone()));
+        h("nat.regiments_by_type", &nat.regiments_by_type, |v| Box::new(v.clone()));
+        h("nat.units_at", &nat.units_at, |v| Box::new(v.clone()));
+        h("nat.men_at", &nat.men_at, |v| Box::new(v.clone()));
+        h("nat.tech_list", &nat.tech_list, |v| Box::new(v.clone()));
+        h("nat.invention_ids", &nat.invention_ids, |v| Box::new(v.clone()));
+        h("nat.modifiers", &nat.modifiers, |v| Box::new(v.clone()));
+        h("nat.country_flags", &nat.country_flags, |v| Box::new(v.clone()));
+        h("nat.reforms", &nat.reforms, |v| Box::new(v.clone()));
+        h("nat.pop_by_type", &nat.pop_by_type, |v| Box::new(v.clone()));
+        h("nat.pop_by_culture", &nat.pop_by_culture, |v| Box::new(v.clone()));
+        h("nat.goods_supply", &nat.goods_supply, |v| Box::new(v.clone()));
+    }
+    for x in held {
+        h("Held (tag, record_tag, tech_list, invention_ids, government)", x, |v| Box::new((v.tag.clone(),
+          v.record_tag.clone(), v.tech_list.clone(), v.invention_ids.clone(), v.government.clone())));
+    }
+}
